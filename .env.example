# Copy to .env and fill in. Never commit the filled-in file.
#
# One Harvest personal access token authenticates both the Harvest and the
# Forecast API. Create it at https://id.getharvest.com/developers.
AuthorizationBearer=

# Shown next to the token at https://id.getharvest.com/developers, under the
# account with a product of "harvest".
HarvestAccountID=

# A different number from HarvestAccountID: the numeric id in the Forecast web
# URL, https://forecastapp.com/<ForecastAccountID>/schedule/team. Leave blank to
# use the Harvest tools only — the forecast__ tools will report it as missing.
ForecastAccountID=
